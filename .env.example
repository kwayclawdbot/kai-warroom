# Kai War Room — environment variables
# Copy to .env.local and fill in.

# Single-user credentials for the War Room
SHARED_USERNAME=
SHARED_PASSWORD=

# Secret used to sign the session cookie. Generate with:
#   openssl rand -hex 32
SESSION_SECRET=

# kai-agent (Railway) — private, proxied via /api/chat. Never exposed to browser.
KAI_AGENT_URL=https://cheatcode-ai.up.railway.app
KAI_AVATAR_TOKEN=
# Phone of the kai-agent user in E.164 (e.g. +15551234567).
KAI_USER_ID=

# OpenAI key — used server-side for TTS (sentence-by-sentence) and Whisper STT.
OPENAI_API_KEY=
