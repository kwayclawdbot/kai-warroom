# Kai War Room — environment variables
# Copy to .env.local and fill in.

# Supabase (auth + user lookup). Public-prefixed so they reach the browser
# client; the anon key is safe to expose, RLS does the gating.
NEXT_PUBLIC_SUPABASE_URL=https://ryprohqthwflinadqotj.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# kai-agent (Railway) — private, proxied via /api/chat. Never exposed to
# browser. For Slice 3 this flips to the kai-agent-warroom URL so production
# SMS Kai stays isolated.
KAI_AGENT_URL=https://cheatcode-ai.up.railway.app
KAI_AVATAR_TOKEN=

# OpenAI key — used server-side for TTS (sentence-by-sentence) and Whisper STT.
# Will be partially superseded by Deepgram (Slice 4) and Cartesia (Slice 5).
OPENAI_API_KEY=
