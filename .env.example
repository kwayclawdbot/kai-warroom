# Kai War Room — environment variables
# Copy to .env.local and fill in.

# Single-user credentials for the War Room
SHARED_USERNAME=
SHARED_PASSWORD=

# Secret used to sign the session cookie. Generate with:
#   openssl rand -hex 32
SESSION_SECRET=

# Brain server — private, proxied via /api/chat. Never exposed to browser.
BRAIN_API_URL=https://kai-warroom-brain.up.railway.app
BRAIN_TOKEN=
