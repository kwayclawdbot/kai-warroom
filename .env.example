# Kai War Room — environment variables
# Copy to .env.local and fill in.

# Single-user credentials for the War Room
SHARED_USERNAME=
SHARED_PASSWORD=

# Secret used to sign the session cookie. Generate with:
#   openssl rand -hex 32
SESSION_SECRET=

# Brain server URL (Railway, populated once Task #3 is deployed)
NEXT_PUBLIC_BRAIN_API_URL=https://kai-warroom-brain.up.railway.app

# Deepgram token endpoint on the brain server (returns short-lived browser key)
NEXT_PUBLIC_DEEPGRAM_TOKEN_ENDPOINT=/deepgram/token
